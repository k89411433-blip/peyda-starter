NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pida:pida_dev_only@localhost:5432/pida?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ACCESS_TTL=15m
BCRYPT_ROUNDS=12
# Bootstrap admin only: set once for first deployment, then unset after seeding.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
